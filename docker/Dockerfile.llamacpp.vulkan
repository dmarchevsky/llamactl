# WebUI build stage
FROM node:20-alpine AS webui-builder

WORKDIR /webui

RUN apk add --no-cache git

RUN git clone --depth 1 -b main https://github.com/dmarchevsky/llamactl.git /src

RUN cp -r /src/webui/. ./ && npm ci && npm run build

# Go build stage
# Uses a glibc-based image (not alpine/musl) so the resulting binary is
# compatible with the glibc-based llama.cpp final image below.
FROM golang:1.26 AS llamactl-builder

WORKDIR /build

RUN git clone --depth 1 -b main https://github.com/dmarchevsky/llamactl.git .

COPY --from=webui-builder /webui/dist ./webui/dist

RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o llamactl ./cmd/server

# Final stage
FROM ghcr.io/ggml-org/llama.cpp:server-vulkan

COPY --from=llamactl-builder /build/llamactl /usr/local/bin/llamactl
RUN chmod +x /usr/local/bin/llamactl

# Set working directory
RUN mkdir -p /data
WORKDIR /data

# Expose the default llamactl port
EXPOSE 8080

ENV LLAMACTL_LLAMACPP_COMMAND=/app/llama-server
ENV LD_LIBRARY_PATH="/app:/usr/local/lib:/usr/lib"

# Set llamactl as the entrypoint
ENTRYPOINT ["llamactl"]
